@page
@model LoginModel

@{
    ViewData["Title"] = "Acceso";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <h1 class="text-center mb-4">@ViewData["Title"]</h1>
            <div class="card">
                <div class="card-body">
                    <section>
                        <form id="account" method="post">
                            <h4 class="mb-3">Usa una cuenta local para iniciar sesión.</h4>
                            <hr />
                            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                            <div class="mb-3">
                                <label asp-for="Input.Email" class="form-label">Correo Electrónico</label>
                                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="nombre@ejemplo.com" />
                                <span asp-validation-for="Input.Email" class="text-danger"></span>
                            </div>
                            <div class="mb-3">
                                <label asp-for="Input.Password" class="form-label">Contraseña</label>
                                <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="contraseña" />
                                <span asp-validation-for="Input.Password" class="text-danger"></span>
                            </div>
@*                             <div class="mb-3 form-check">
                                <input class="form-check-input" asp-for="Input.RememberMe" />
                                <label class="form-check-label" asp-for="Input.RememberMe">
                                    @Html.DisplayNameFor(m => m.Input.RememberMe)
                                </label>
                            </div> *@
                            <div>
                                <button id="login-submit" type="submit" class="w-100 btn btn-lg btn-primary">Iniciar Sesión</button>
                            </div>
                            <div class="mt-3">
@*                                 <p>
                                    <a id="forgot-password" asp-page="./ForgotPassword">¿Olvidaste tu contraseña?</a>
                                </p> *@
                                <p>
                                    <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Regístrate como un nuevo usuario</a>
                                </p>
@*                                 <p>
                                    <a id="resend-confirmation" asp-page="./ResendEmailConfirmation">Reenviar correo de confirmación</a>
                                </p> *@
                            </div>
                        </form>
                    </section>
                </div>
            </div>
        </div>
@*         <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <section>
                        <h4 class="mb-3">Usa otro servicio para iniciar sesión.</h4>
                        <hr />
                        @{
                            if ((Model.ExternalLogins?.Count ?? 0) == 0)
                            {
                                <div>
                                    <p>
                                        No hay servicios de autenticación externos configurados. Consulta este <a href="https://go.microsoft.com/fwlink/?LinkID=532715">
                                            artículo
                                            sobre cómo configurar esta aplicación ASP.NET para admitir el inicio de sesión a través de servicios externos
                                        </a>.
                                    </p>
                                </div>
                            }
                            else
                            {
                                <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="form-horizontal">
                                    <div>
                                        <p>
                                            @foreach (var provider in Model.ExternalLogins!)
                                            {
                                                <button type="submit" class="btn btn-primary me-2" name="provider" value="@provider.Name" title="Iniciar sesión usando tu cuenta de @provider.DisplayName">@provider.DisplayName</button>
                                            }
                                        </p>
                                    </div>
                                </form>
                            }
                        }
                    </section>
                </div>
            </div>
        </div>
 *@    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}